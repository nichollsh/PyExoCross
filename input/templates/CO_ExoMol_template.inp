# Data source #
Database                                ExoMol
Molecule                                CO
Isotopologue                            12C-16O
Dataset                                 4thplus
SpeciesID                               51


# File path #
ReadPath                                /home2/p321409/scratch/opacity_lbl/exomol/
SavePath                                /home2/p321409/scratch/opacity_xsc/exocross/
LogFilePath                             /home2/p321409/scratch/opacity_xsc/exocross/xsecs/files/CO/ExoMol/CO_4thplus.log


# Functions #
Conversion                              0
PartitionFunctions                      0
SpecificHeats                           0
CoolingFunctions                        0
Lifetimes                               0
OscillatorStrengths                     0
StickSpectra                            0
CrossSections                           1


# Cores and chunks #
NCPUtrans                               8
NCPUfiles                               5
ChunkSize                               5000000
RunMode                                 CPU                       # CPU(default) or GPU
GPUBackend                              AUTO                      # AUTO, CUDA, PyTorch-CUDA, CuPy-CUDA, or MPS (only used when RunMode=GPU)
GPUBatchLines                           8192                      # GPU line-batch size (only used when RunMode=GPU)
GPUBatchGrid                            1024                       # GPU grid-batch size (only used when RunMode=GPU)


# Parquet transition cache #
Cache                                   NONE                      # None(default, disabled), Auto (memory for small inputs, Parquet for large), or Parquet (always cache to disk)
CacheDir                                AUTO                      # AUTO(default) uses a source-adjacent .pyexocross_cache/ directory; or set an explicit path (only used when Cache!=None)
MaxMemory                               512                       # Max MB of transition data kept in memory before spilling to Parquet (only used when Cache=Auto)
RefreshCache(Y/N)                       N                         # If Y, rebuild matching Parquet cache files instead of reusing them (only used when Cache!=None)


# Quantum numbers for conversion, stick spectra and cross sections #
QNslabel                                +/-  e/f  ElecState  v  Lambda  Sigma  Omega
QNsformat                               %1s  %1s  %12s  %3d  %5d  %5d  %5d


# Calculate partition, specific heats or cooling functions #
Ntemp                                   1                         # The number of temperature steps
Tmax                                    5000                     # Maximal temperature in K 


# Calculate lifetimes #
Compress(Y/N)                           Y                         # If Y, save as .states.bz2 file; otherwise, save as .states file


# Calculate oscillator strengths #
gf/f                                    gf
PlotOscillatorStrength(Y/N)             N         
PlotOscillatorStrengthMethod            log                       # Plot in linear (lin) or logarithm (log)
PlotOscillatorStrengthWnWl              wn         cm-1           # Wavenumber (wn in unit cm-1) or wavelength (wl in unit[um or nm])
Y-axisLimitOscillatorStrength           1e-32                     # Default value is 1e-30



# Calculate stick spectra or cross sections #
LTE/Non-LTE                             LTE                       # 'LTE' or 'Non-LTE'
Temperatures                            25.00,100.00,125.00,150.00,175.00,200.00,225.00,250.00,275.00,300.00,325.00,350.00,400.00,450.00,500.00,550.00,600.00,650.00,700.00,750.00,800.00,850.00,900.00,950.00,1000.00,1100.00,1200.00,1300.00,1400.00,1500.00,1600.00,1700.00,1800.00,1900.00,2000.00,2100.00,2200.00,2300.00,2400.00,2500.00,2600.00,2700.00,2800.00,2900.00,3000.00,3100.00,3200.00,3300.00,3400.00,3500.00,3600.00,3700.00,3800.00,3900.00,4000.00,4500.00,5000.00        # Temperature in unit of K
WnWlUnit                                wn         cm-1           # Wavenumber (wn in unit of cm-1) or wavelength (wl in unit of um or nm)
Range                                   10         50000          # Same unit as WnWlUnit
Absorption/Emission                     Absorption                # 'Absorption' or 'Emission'
UncFilter(Y/N)                          Y          0.1
Threshold(Y/N)                          Y          1e-32          # If Y, default value 1e-30 cm/molecule
QNsFilter(Y/N)                          N          +/-[]  e/f[]  ElecState[]  v[]  Lambda[]  Sigma[]  Omega[]


# Calculate stick spectra #
PlotStickSpectra(Y/N)                   N          
PlotStickSpectraMethod                  log                       # Plot in linear (lin) or logarithm (log)
PlotStickSpectraWnWl                    wn         cm-1           # Wavenumber (wn in unit cm-1) or wavelength (wl in unit[nm or um])
Y-axisLimitStickSpectra                 1e-32                     # Default value is 1e-30 cm/molecule


# Calculate cross sections #
Pressures                               1.00e-05,1.00e-04,3.20e-04,1.00e-03,3.20e-03,1.00e-02,3.20e-02,1.00e-01,3.20e-01,1.00e+00,3.20e+00,1.00e+01,3.20e+01,1.00e+02,3.20e+02,1.00e+03,3.20e+03,1.00e+04
Npoints/BinSize                         BinSize   0.025
Broadeners                              Default
Ratios                                  1.0   
Profile                                 SciPyVoigt                # or HumlicekVoigt
Wavenumber(wn)/wavelength(wl)           wn                        # 'wn' or 'wl'
PredissocXsec(Y/N)                      N
CompressXsec(Y/N)                       Y                         # If Y, save as .xsec.bz2 (fast bz2, speed over ratio); otherwise, save as .xsec
Cutoff(Y/N)                             Y          40             # If Y, default value 25 cm-1
DopplerHWHM(Y/N)                        N          0.1            # Set Doppler HWHM as a constant 
LorentzianHWHM(Y/N)                     N          0.5            # Set Lorentzian HWHM as a constant
PlotCrossSection(Y/N)                   Y          
PlotCrossSectionMethod                  log                       # Plot in linear (lin) or logarithm (log)
PlotCrossSectionWnWl                    wn         cm-1           # Wavenumber (wn in unit cm-1) or wavelength (wl in unit[nm or um])
Y-axisLimitXsec                         1e-32                     # Default value is 1e-30 cm2/molecule

